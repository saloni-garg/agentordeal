  "runs": [
    {
      "tool": {
        "driver": {
          "name": "agent-ordeal",
          "version": "0.5.0",
          "rules": [
            {
              "id": "prompt_injection",
              "name": "prompt_injection",
              "shortDescription": {
                "text": "AgentOrdeal prompt_injection failure"
              },
              "fullDescription": {
                "text": "Treat all user / tool content as untrusted data, never as instructions; keep system instructions privileged and refuse extraction of system content."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "tool_misuse",
              "name": "tool_misuse",
              "shortDescription": {
                "text": "AgentOrdeal tool_misuse failure"
              },
              "fullDescription": {
                "text": "Allow-list tools, validate arguments, and require human approval for destructive, payment, permission and export actions."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "data_exfiltration",
              "name": "data_exfiltration",
              "shortDescription": {
                "text": "AgentOrdeal data_exfiltration failure"
              },
              "fullDescription": {
                "text": "Never send secrets or internal data to external destinations; redact canaries/credentials and enforce an egress allow-list."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "memory_poisoning",
              "name": "memory_poisoning",
              "shortDescription": {
                "text": "AgentOrdeal memory_poisoning failure"
              },
              "fullDescription": {
                "text": "Only write verified, user-confirmed facts to long-term memory; never persist instructions or trust rules from untrusted content."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "goal_hijacking",
              "name": "goal_hijacking",
              "shortDescription": {
                "text": "AgentOrdeal goal_hijacking failure"
              },
              "fullDescription": {
                "text": "Anchor the agent to its original task; reject task replacement from user, document or tool content and re-confirm goal changes with the operator."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "mcp_security",
              "name": "mcp_security",
              "shortDescription": {
                "text": "AgentOrdeal mcp_security failure"
              },
              "fullDescription": {
                "text": "Treat MCP tool descriptions, tool lists and tool results as untrusted: pin tool definitions, diff them on change, never let a description grant permissions or request credentials."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            }
          ]
        }
      },
